terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# ============================================
# ПЕРЕМЕННЫЕ
# ============================================
variable "aws_region" {
  description = "AWS region for resources"
  type        = string
  default     = "us-east-1"
}

variable "cidr_collection_name" {
  description = "Name of the Route53 CIDR collection"
  type        = string
  default     = "my-production-cidr-collection"
}

variable "locations" {
  description = "Map of CIDR locations"
  type = map(object({
    cidr_blocks = list(string)
  }))
  default = {
    "us-west-office" = {
      cidr_blocks = ["10.0.0.0/24", "10.0.1.0/24", "10.0.2.0/24"]
    }
    "us-east-office" = {
      cidr_blocks = ["10.1.0.0/24", "10.1.1.0/24"]
    }
    "eu-central-office" = {
      cidr_blocks = ["10.2.0.0/24"]
    }
  }
}

variable "environment" {
  description = "Environment tag"
  type        = string
  default     = "production"
}

# ============================================
# ОСНОВНОЙ РЕСУРС: Route53 CIDR Collection
# ============================================
resource "aws_route53_cidr_collection" "main" {
  name = var.cidr_collection_name

  tags = {
    Name        = var.cidr_collection_name
    Environment = var.environment
    ManagedBy   = "Terraform"
    CreatedAt   = timestamp()
  }
}

# ============================================
# ВСПОМОГАТЕЛЬНЫЕ РЕСУРСЫ: CIDR Locations
# ============================================
resource "aws_route53_cidr_location" "locations" {
  for_each = var.locations

  cidr_collection_id = aws_route53_cidr_collection.main.id
  name               = each.key
  cidr_blocks        = each.value.cidr_blocks
}

# ============================================
# ДАННЫЕ (Data Sources) 
# ============================================
data "aws_caller_identity" "current" {}

data "aws_region" "current" {}

# ============================================
# ВЫВОДЫ (Outputs)
# ============================================
output "cidr_collection_id" {
  description = "The ID of the CIDR collection"
  value       = aws_route53_cidr_collection.main.id
}

output "cidr_collection_arn" {
  description = "The ARN of the CIDR collection"
  value       = aws_route53_cidr_collection.main.arn
}

output "cidr_collection_version" {
  description = "Current version of the CIDR collection"
  value       = aws_route53_cidr_collection.main.version
}

output "cidr_collection_name" {
  description = "Name of the CIDR collection"
  value       = aws_route53_cidr_collection.main.name
}

output "locations_created" {
  description = "Map of created locations"
  value = {
    for k, loc in aws_route53_cidr_location.locations :
    k => {
      id          = loc.id
      cidr_blocks = loc.cidr_blocks
    }
  }
}

output "account_id" {
  description = "AWS Account ID"
  value       = data.aws_caller_identity.current.account_id
}

output "region" {
  description = "Current AWS region"
  value       = data.aws_region.current.name
}

# ============================================
# ИНФОРМАЦИЯ О ВЕРСИИ КОЛЛЕКЦИИ (локальные значения)
# ============================================
locals {
  total_cidr_blocks = sum([
    for loc in aws_route53_cidr_location.locations : length(loc.cidr_blocks)
  ])

  collection_info = {
    name            = aws_route53_cidr_collection.main.name
    id              = aws_route53_cidr_collection.main.id
    version         = aws_route53_cidr_collection.main.version
    total_locations = length(aws_route53_cidr_location.locations)
    total_cidrs     = local.total_cidr_blocks
    environment     = var.environment
    region          = data.aws_region.current.name
    account_id      = data.aws_caller_identity.current.account_id
  }
}

output "collection_summary" {
  description = "Summary information about the CIDR collection"
  value       = local.collection_info
}
