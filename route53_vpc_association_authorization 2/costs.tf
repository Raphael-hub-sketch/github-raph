# ==============================================================================
# costs.tf
# ПРИМЕЧАНИЕ О ЗАТРАТАХ (имитация)
# ==============================================================================
#
# Данный файл добавлен исключительно для демонстрации того, как могли бы
# выглядеть затраты, если бы ресурс был платным. В нём нет реальных ресурсов,
# только комментарии и locals для наглядности.
#
# В реальности:
# - aws_route53_vpc_association_authorization: $0.00
# - aws_route53_zone_association: $0.00
# - aws_route53_zone (частная): $0.50 в месяц за зону
# - aws_vpc: $0.00 (VPC бесплатны)
#
# Infracost покажет для всего проекта примерно:
# - aws_route53_zone.private: $0.50/мес
# - Остальные ресурсы: $0.00
# - ИТОГО: ~$0.50/мес (только за частную зону)
#
# Если бы AWS взимал плату за авторизацию (гипотетически):
# - aws_route53_vpc_association_authorization: $0.50 за создание (разово)
# - ИТОГО с зоной: ~$1.00/мес (при амортизации разовой платы на 1 год)
#
# ==============================================================================

locals {
  # Имитация структуры затрат для демонстрации (не используется в реальных ресурсах)
  cost_estimate = {
    route53_private_zone = {
      unit_price_usd = 0.50
      quantity       = 1
      period         = "month"
      total_usd      = 0.50
    }
    route53_vpc_association_authorization = {
      unit_price_usd = 0.00
      quantity       = 1
      period         = "month"
      total_usd      = 0.00
      note           = "AWS не взимает плату за этот ресурс"
    }
    route53_zone_association = {
      unit_price_usd = 0.00
      quantity       = 1
      period         = "month"
      total_usd      = 0.00
      note           = "AWS не взимает плату за этот ресурс"
    }
    vpc = {
      unit_price_usd = 0.00
      quantity       = 2
      period         = "month"
      total_usd      = 0.00
      note           = "VPC бесплатны, платите только за ресурсы внутри"
    }
  }

  # Итоговая гипотетическая сумма (для наглядности)
  total_monthly_cost_usd = 0.50
}