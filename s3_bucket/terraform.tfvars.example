# terraform.tfvars.example
# Скопируйте этот файл в terraform.tfvars и настройте под себя.
# НЕ КОММИТЬТЕ terraform.tfvars с реальными данными!

aws_region   = "us-east-1"
environment  = "dev"
project_name = "s3-cost-demo"

# Если null — имя бакета будет сгенерировано автоматически
bucket_name = null

# Функциональные флаги
enable_versioning          = true
enable_lifecycle           = true
enable_encryption          = true
enable_logging             = false
enable_public_access_block = true

# Параметры жизненного цикла
lifecycle_glacier_days    = 90
lifecycle_expiration_days = 365

# Параметры для имитации затрат
storage_gb             = 100
monthly_requests       = 1000000
versioning_overhead_gb = 20
logging_gb             = 5
transition_objects     = 10000